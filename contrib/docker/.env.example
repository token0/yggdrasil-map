# Repository to build from, ref after '#'
MAP_GIT_CONTEXT=https://github.com/token0/yggdrasil-map.git#master

# Host directory containing the yggdrasil admin socket and the socket's file name.
# Debian/Ubuntu package: /var/run/yggdrasil + yggdrasil.sock
# Plain build default:   /var/run + yggdrasil.sock (mounts all of /var/run read-only)
YGG_SOCKET_DIR=/var/run/yggdrasil
YGG_SOCKET_NAME=yggdrasil.sock

# Published web port; 127.0.0.1 if the reverse proxy runs on the same host
MAP_BIND=127.0.0.1
MAP_PORT=3000

# Seconds between collect + render runs
UPDATE_INTERVAL=600
