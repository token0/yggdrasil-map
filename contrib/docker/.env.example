# Image built by .github/workflows/docker.yml (tags: latest, sha-<short>, <semver>)
MAP_IMAGE=ghcr.io/token0/yggdrasil-map:latest

# Peers of the embedded node, separated by spaces or commas. Only used when
# yggdrasil.conf is generated (first start); afterwards edit Peers in that file.
YGG_PEERS=tls://192.0.2.10:12345

# Published web port; 127.0.0.1 if the reverse proxy runs on the same host
MAP_BIND=127.0.0.1
MAP_PORT=3000

# Seconds between collect + render runs
UPDATE_INTERVAL=600
